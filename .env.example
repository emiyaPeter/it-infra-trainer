# ============================================================
# IT Infra Trainer — 环境变量模板
# 复制此文件为 .env 并填入你的密钥（推荐用 npm run set-key 交互配置）
# .env 已被 .gitignore 忽略，不会提交到 Git、不会出现在网页
# ============================================================

# --- AI 答疑（OpenAI 兼容接口，三件套；换服务商改这三行即可）---
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 旧版键名（兼容保留，AI_* 优先）：
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com
