{
  "name": "it-infra-trainer",
  "version": "1.2.0",
  "description": "IT基础设施工程师培训助手 - 零基础到3年经验水平",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:static": "vitepress build docs && vitepress preview docs",
    "cli": "node src/cli/index.js",
    "setup": "node scripts/init-db.js && node src/cli/index.js env-check",
    "init-db": "node scripts/init-db.js",
    "auth": "node src/server/auth-server.js",
    "backup": "node scripts/backup-db.js",
    "test": "node scripts/smoke-test.js",
    "dev": "node scripts/start-all.js"
  },
  "bin": {
    "it-trainer": "./src/cli/index.js"
  },
  "keywords": [
    "training",
    "it-infrastructure",
    "learning",
    "devops"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "inquirer": "^12.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^14.0.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "vitepress": "^1.3.0",
    "vue": "^3.4.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.21.5": true
  }
}
